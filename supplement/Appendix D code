run_jobs <- function(jobs, worker) {
  if (length(jobs) == 0) return(list())
  if (N_CORES <= 1) return(lapply(jobs, worker))
  cl <- parallel::makeCluster(min(N_CORES, length(jobs)))
  on.exit(parallel::stopCluster(cl), add = TRUE)
  parallel::clusterExport(cl, WORKER_EXPORTS, envir = environment(run_jobs))
  parallel::clusterEvalQ(cl, {
    if (!requireNamespace("numDeriv", quietly = TRUE)) stop("numDeriv unavailable on worker")
    NULL
  })
  parallel::parLapply(cl, jobs, worker)
}

bind_nonempty <- function(rows) {
  rows <- rows[!vapply(rows, is.null, logical(1))]
  if (length(rows) == 0) return(NULL)
  out <- do.call(rbind, rows)
  rownames(out) <- NULL
  out
}

summarize_designs <- function(pilot_results, power_results, scenario_names) {
  rows <- list()
  for (sc in scenario_names) {
    dat <- pilot_results[pilot_results$scenario == sc, , drop = FALSE]
    grd <- power_results[power_results$scenario == sc, , drop = FALSE]
    N_required <- interp_required_N(grd$N, grd$power, TARGET_POWER)
    for (st in c("rct", "median", "ucb_median", "mean", "ucb_mean", "q70", "q90")) {
      if (st == "rct") {
        one <- dat[!duplicated(dat$rep_id), , drop = FALSE]
        N <- one$N_rct
        pw <- one$power_Nrct
      } else {
        one <- dat[dat$stable_name == st, , drop = FALSE]
        N <- one$N_proposed
        pw <- one$power_Nprop
      }
      N <- N[is.finite(N)]
      pw <- pw[is.finite(pw)]
      if (length(N) == 0) next
      qpw <- if (length(pw)) as.numeric(quantile(pw, c(0.025, 0.975))) else c(NA_real_, NA_real_)
      rows[[length(rows) + 1]] <- data.frame(
        scenario = sc, stable_name = st,
        n_pilots_attempted = PILOT_REPS, n_pilot_designs = length(N),
        design_availability_rate = length(N) / PILOT_REPS,
        N_mean = mean(N), N_median = median(N),
        N_q025 = as.numeric(quantile(N, 0.025)),
        N_q975 = as.numeric(quantile(N, 0.975)),
        n_power_mapped = length(pw),
        mean_power_pct = if (length(pw)) 100 * mean(pw) else NA_real_,
        power_empirical_lower_pct = 100 * qpw[1],
        power_empirical_upper_pct = 100 * qpw[2],
        hit_rate_pct = if (length(pw)) 100 * mean(pw >= TARGET_POWER) else NA_real_,
        N_req_interp = N_required, stringsAsFactors = FALSE
      )
    }
  }
  bind_nonempty(rows)
}

run_binary_sensitivity <- function(output_dir = OUTPUT_DIR) {
  stopifnot(PILOT_REPS >= 1, B_REPS >= 100, B_UCB >= 50, NSIMS_POWER >= 1,
            PILOT_SMALL >= 2, is.finite(FINAL_SLOPE_C), is.finite(FINAL_SLOPE_D))
  dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
  if (!dir.exists(output_dir)) stop("Could not create output directory.")
  
  scenario_names <- c("a_pilot200", "b_correlated3", "c_final_slope04", "d_final_slope12")
  settings <- data.frame(
    scenario = scenario_names, p0 = P0_TARGET, marginal_OR = exp(DELTA_TARGET_BIN),
    treatment_prevalence = TREAT_RATIO_BIN,
    pilot_size = c(PILOT_SMALL, 600, 600, 600),
    pilot_PS_slope = c(0.8, NA_real_, 0.8, 0.8),
    final_PS_slope = c(0.8, NA_real_, FINAL_SLOPE_C, FINAL_SLOPE_D),
    n_confounders = c(1, 3, 1, 1),
    pairwise_correlation = c(NA_real_, MULTI_COR, NA_real_, NA_real_),
    multi_PS_coefficients = c("", paste(MULTI_PS_COEF, collapse = ", "), "", ""),
    multi_Y_coefficients = c("", paste(MULTI_Y_COEF, collapse = ", "), "", ""),
    stringsAsFactors = FALSE
  )
  write.csv(settings, file.path(output_dir, "scenario_settings.csv"), row.names = FALSE)
  capture.output(sessionInfo(), file = file.path(output_dir, "session_info.txt"))
  if (QUICK_CHECK) message("QUICK_CHECK: execution check only; do not report these estimates.")
  
  # Generate pilots for (a), (b), and (c).
  # (c) and (d) share n_pilot=600, pilot PS slope=0.8, and all proposed sample sizes.
  # Only their final-study slopes differ: 0.4 versus 1.2.
  pilot_scenarios <- c("a_pilot200", "b_correlated3", "c_final_slope04")
  jobs <- list()
  for (sc in pilot_scenarios) {
    for (r in seq_len(PILOT_REPS)) {
      jobs[[length(jobs) + 1]] <- list(
        rep_id = r, scenario = sc,
        pilot_size = if (sc == "a_pilot200") PILOT_SMALL else 600,
        multivariate = sc == "b_correlated3"
      )
    }
  }
  message(sprintf("Pilot stage: %d experiments, %d bootstraps each.", length(jobs), B_REPS))
  pilot_runs <- run_jobs(jobs, pilot_task_worker)
  diagnostics <- bind_nonempty(lapply(pilot_runs, function(x) x$diagnostics))
  pilot_results <- bind_nonempty(lapply(pilot_runs, function(x) x$rows))
  write.csv(diagnostics, file.path(output_dir, "pilot_diagnostics.csv"), row.names = FALSE)
  if (is.null(pilot_results)) stop("No usable pilots; inspect pilot_diagnostics.csv.")
  missing_sc <- setdiff(pilot_scenarios, unique(pilot_results$scenario))
  if (length(missing_sc)) stop("No usable pilots for: ", paste(missing_sc, collapse = ", "))
  
  # Reuse the exact pilot-based designs from (c); no extra pilot bootstraps for (d).
  rows_d <- pilot_results[pilot_results$scenario == "c_final_slope04", , drop = FALSE]
  rows_d$scenario <- "d_final_slope12"
  pilot_results <- rbind(pilot_results, rows_d)
  diag_d <- diagnostics[diagnostics$scenario == "c_final_slope04", , drop = FALSE]
  diag_d$scenario <- "d_final_slope12"
  diagnostics <- rbind(diagnostics, diag_d)
  diagnostics$reused_pilot_design <- diagnostics$scenario == "d_final_slope12"
  
  # Checkpoint before the expensive power stage.
  write.csv(pilot_results, file.path(output_dir, "pilot_uncertainty_N_distributions.csv"), row.names = FALSE)
  write.csv(diagnostics, file.path(output_dir, "pilot_diagnostics.csv"), row.names = FALSE)
  saveRDS(list(pilot_results = pilot_results, diagnostics = diagnostics, settings = settings),
          file.path(output_dir, "pilot_checkpoint.rds"))
  
  # Original per-scenario sparse grid: pooled across stability choices, plus RCT N.
  power_jobs <- list()
  for (sc in scenario_names) {
    dat <- pilot_results[pilot_results$scenario == sc, , drop = FALSE]
    grid <- make_sparse_grid(
      dat$N_proposed, probs = seq(0.05, 0.95, by = 0.05),
      include_minmax = TRUE, include_mean = TRUE,
      N_rct = as.numeric(quantile(dat$N_rct, 0.50))
    )
    message(sprintf("%s: %d power grid points (N=%d to %d).",
                    sc, nrow(grid), min(grid$N), max(grid$N)))
    for (j in seq_len(nrow(grid))) {
      power_jobs[[length(power_jobs) + 1]] <- list(
        scenario = sc, N = as.integer(grid$N[j]), grid_label = grid$grid_label[j],
        conf_effect = if (sc == "c_final_slope04") FINAL_SLOPE_C else
          if (sc == "d_final_slope12") FINAL_SLOPE_D else 0.8,
        multivariate = sc == "b_correlated3",
        population_id = if (sc == "b_correlated3") 3 else
          if (sc == "c_final_slope04") 2 else if (sc == "d_final_slope12") 4 else 1
      )
    }
  }
  message(sprintf("Power stage: %d grid tasks, %d simulated studies each.",
                  length(power_jobs), NSIMS_POWER))
  power_results <- bind_nonempty(run_jobs(power_jobs, power_task_worker))
  power_results <- power_results[order(match(power_results$scenario, scenario_names), power_results$N), ]
  write.csv(power_results, file.path(output_dir, "power_validation_sparse_grid.csv"), row.names = FALSE)
  
  pilot_results$power_Nprop <- NA_real_
  pilot_results$power_Nrct <- NA_real_
  for (sc in scenario_names) {
    idx <- which(pilot_results$scenario == sc)
    grd <- power_results[power_results$scenario == sc, , drop = FALSE]
    pilot_results$power_Nprop[idx] <- interp_power_at_N(
      pilot_results$N_proposed[idx], grd$N, grd$power, enforce_monotone = TRUE)$power
    pilot_results$power_Nrct[idx] <- interp_power_at_N(
      pilot_results$N_rct[idx], grd$N, grd$power, enforce_monotone = TRUE)$power
  }
  summary <- summarize_designs(pilot_results, power_results, scenario_names)
  write.csv(pilot_results, file.path(output_dir, "pilot_uncertainty_N_distributions.csv"), row.names = FALSE)
  write.csv(summary, file.path(output_dir, "sensitivity_summary.csv"), row.names = FALSE)
  
  result <- list(settings = settings, pilot_results = pilot_results,
                 pilot_diagnostics = diagnostics, power_results = power_results, summary = summary)
  saveRDS(result, file.path(output_dir, "binary_sensitivity_results.rds"))
  print(summary, row.names = FALSE)
  message("Done. Results saved to: ", normalizePath(output_dir, winslash = "/"))
  message("Power uses successful final-study fits only, as in the original code; inspect success_rate.")
  message("Empirical power intervals describe variation across pilots, not CIs for mean power.")
  invisible(result)
}

